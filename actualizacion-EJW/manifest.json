{
  "name": "EJW Notas",
  "short_name": "EJW",
  "description": "Procesador de texto y notas: páginas tamaño carta, carpetas por días y PDF.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e5e7eb",
  "theme_color": "#2563eb",
  "lang": "es",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/plain": [
          ".txt",
          ".md"
        ],
        "text/html": [
          ".html",
          ".htm"
        ],
        "application/msword": [
          ".doc"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}